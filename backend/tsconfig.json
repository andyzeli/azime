{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "./src",
    "customConditions": ["development"]
    //"ignoreDeprecations": "6.0",
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}

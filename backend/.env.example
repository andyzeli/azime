# Each pass picks a provider (gemini | openai | claude) and reads only that
# provider's model/reasoning settings. Every pass uses each provider's most
# capable model at high reasoning (checked 2026-11): output quality matters far
# more than model cost here. Unset model vars fall back to GEMINI_MODEL / code
# defaults for Gemini, and are required for OpenAI/Claude.
# claude-fable-5-1 is Anthropic's most capable model, but it is not available to
# zero-data-retention orgs (400), so it is only an option if ours allows it.
#
# Reasoning settings are optional; blank/unset uses the model default.
# Claude effort: low, medium, high, xhigh, max. Default is medium on Opus 5.5 /
#   Haiku 5.5 and high on Sonnet 5.5. Thinking is adaptive; no temperature/budget.
# OpenAI effort: none, minimal, low, medium, high, xhigh, max (model-dependent;
#   gpt-6-astra and gpt-6.1-sol reject none).
# Gemini 3/4: thinking level minimal, low, medium, high (model-dependent).
# Gemini 2.5: thinking budget in tokens; -1 = dynamic, 0 = off where supported.
# Set a Gemini level OR budget, never both. Provider enforces model-specific support.
# GEMINI_THINKING_* applies only to record extraction. Other passes use their own
# settings (no inheritance, even when the model/provider falls back).
# Pre-exam delta uses PRE_EXAM_ANALYSIS settings.

GCP_BUCKET_NAME=
GCP_PROJECT_ID=
GCP_LOCATION=global

# Pass 1: per-record PDF extraction (Gemini only; reads the PDF from GCS).
GEMINI_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=high
GEMINI_THINKING_BUDGET=

# Pass 2: cross-record case summary.
CASE_SUMMARY_PROVIDER=gemini
CASE_SUMMARY_GEMINI_MODEL=gemini-4-argon
CASE_SUMMARY_GEMINI_THINKING_LEVEL=high
CASE_SUMMARY_GEMINI_THINKING_BUDGET=
CASE_SUMMARY_OPENAI_MODEL=gpt-6-astra
CASE_SUMMARY_OPENAI_REASONING_EFFORT=xhigh
CASE_SUMMARY_CLAUDE_MODEL=claude-opus-5-5
CASE_SUMMARY_CLAUDE_EFFORT=xhigh

# Pass 2: one summary per provider, run in parallel. Falls back to
# CASE_SUMMARY_* provider/model when unset.
PROVIDER_SUMMARY_PROVIDER=gemini
PROVIDER_SUMMARY_GEMINI_MODEL=gemini-4-argon
PROVIDER_SUMMARY_GEMINI_THINKING_LEVEL=high
PROVIDER_SUMMARY_GEMINI_THINKING_BUDGET=
PROVIDER_SUMMARY_OPENAI_MODEL=gpt-6-astra
PROVIDER_SUMMARY_OPENAI_REASONING_EFFORT=xhigh
PROVIDER_SUMMARY_CLAUDE_MODEL=claude-opus-5-5
PROVIDER_SUMMARY_CLAUDE_EFFORT=xhigh
PROVIDER_SUMMARY_CONCURRENCY=4

# Pass 3A: pre-exam analysis (and the added-diagnosis delta). Clinical reasoning.
PRE_EXAM_ANALYSIS_PROVIDER=gemini
PRE_EXAM_ANALYSIS_GEMINI_MODEL=gemini-4-argon
PRE_EXAM_ANALYSIS_GEMINI_THINKING_LEVEL=high
PRE_EXAM_ANALYSIS_GEMINI_THINKING_BUDGET=
PRE_EXAM_ANALYSIS_OPENAI_MODEL=gpt-6-astra
PRE_EXAM_ANALYSIS_OPENAI_REASONING_EFFORT=xhigh
PRE_EXAM_ANALYSIS_CLAUDE_MODEL=claude-opus-5-5
PRE_EXAM_ANALYSIS_CLAUDE_EFFORT=xhigh

# Pass 3B: refined analysis with physician steering.
REFINED_ANALYSIS_PROVIDER=gemini
REFINED_ANALYSIS_GEMINI_MODEL=gemini-4-argon
REFINED_ANALYSIS_GEMINI_THINKING_LEVEL=high
REFINED_ANALYSIS_GEMINI_THINKING_BUDGET=
REFINED_ANALYSIS_OPENAI_MODEL=gpt-6-astra
REFINED_ANALYSIS_OPENAI_REASONING_EFFORT=xhigh
REFINED_ANALYSIS_CLAUDE_MODEL=claude-opus-5-5
REFINED_ANALYSIS_CLAUDE_EFFORT=xhigh

# Post-exam analysis.
POST_EXAM_ANALYSIS_PROVIDER=gemini
POST_EXAM_ANALYSIS_GEMINI_MODEL=gemini-4-argon
POST_EXAM_ANALYSIS_GEMINI_THINKING_LEVEL=high
POST_EXAM_ANALYSIS_GEMINI_THINKING_BUDGET=
POST_EXAM_ANALYSIS_OPENAI_MODEL=gpt-6-astra
POST_EXAM_ANALYSIS_OPENAI_REASONING_EFFORT=xhigh
POST_EXAM_ANALYSIS_CLAUDE_MODEL=claude-opus-5-5
POST_EXAM_ANALYSIS_CLAUDE_EFFORT=xhigh

# Final report draft (long-form Markdown).
REPORT_DRAFT_PROVIDER=gemini
REPORT_DRAFT_GEMINI_MODEL=gemini-4-argon
REPORT_DRAFT_GEMINI_THINKING_LEVEL=high
REPORT_DRAFT_GEMINI_THINKING_BUDGET=
REPORT_DRAFT_OPENAI_MODEL=gpt-6-astra
REPORT_DRAFT_OPENAI_REASONING_EFFORT=xhigh
REPORT_DRAFT_CLAUDE_MODEL=claude-opus-5-5
REPORT_DRAFT_CLAUDE_EFFORT=xhigh

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/azimeGCP.json

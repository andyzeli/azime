# Reasoning settings are optional; blank/unset uses the model default.
# OpenAI effort: none, minimal, low, medium, high, xhigh, max (model-dependent).
# Gemini 3/4: thinking level minimal, low, medium, high (model-dependent).
# Gemini 2.5: thinking budget in tokens; -1 = dynamic, 0 = off where supported.
# Set a Gemini level OR budget, never both. Provider enforces model-specific support.
# GEMINI_THINKING_* applies only to record extraction. Other passes use their own
# settings (no inheritance, even when the model/provider falls back).
# Pre-exam delta uses PRE_EXAM_ANALYSIS settings.

GCP_BUCKET_NAME=
GCP_PROJECT_ID=
GCP_LOCATION=global

GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=
GEMINI_THINKING_BUDGET=

CASE_SUMMARY_PROVIDER=gemini
CASE_SUMMARY_GEMINI_MODEL=gemini-2.5-flash
CASE_SUMMARY_OPENAI_MODEL=
CASE_SUMMARY_OPENAI_REASONING_EFFORT=
CASE_SUMMARY_GEMINI_THINKING_LEVEL=
CASE_SUMMARY_GEMINI_THINKING_BUDGET=

PROVIDER_SUMMARY_PROVIDER=gemini
PROVIDER_SUMMARY_GEMINI_MODEL=gemini-2.5-flash
PROVIDER_SUMMARY_OPENAI_MODEL=
PROVIDER_SUMMARY_OPENAI_REASONING_EFFORT=
PROVIDER_SUMMARY_GEMINI_THINKING_LEVEL=
PROVIDER_SUMMARY_GEMINI_THINKING_BUDGET=
PROVIDER_SUMMARY_CONCURRENCY=4

PRE_EXAM_ANALYSIS_PROVIDER=gemini
PRE_EXAM_ANALYSIS_GEMINI_MODEL=gemini-2.5-flash
PRE_EXAM_ANALYSIS_OPENAI_MODEL=
PRE_EXAM_ANALYSIS_OPENAI_REASONING_EFFORT=
PRE_EXAM_ANALYSIS_GEMINI_THINKING_LEVEL=
PRE_EXAM_ANALYSIS_GEMINI_THINKING_BUDGET=

REFINED_ANALYSIS_PROVIDER=gemini
REFINED_ANALYSIS_GEMINI_MODEL=gemini-2.5-flash
REFINED_ANALYSIS_OPENAI_MODEL=
REFINED_ANALYSIS_OPENAI_REASONING_EFFORT=
REFINED_ANALYSIS_GEMINI_THINKING_LEVEL=
REFINED_ANALYSIS_GEMINI_THINKING_BUDGET=


REPORT_DRAFT_PROVIDER=gemini
REPORT_DRAFT_GEMINI_MODEL=gemini-2.5-flash
REPORT_DRAFT_OPENAI_MODEL=
REPORT_DRAFT_OPENAI_REASONING_EFFORT=
REPORT_DRAFT_GEMINI_THINKING_LEVEL=
REPORT_DRAFT_GEMINI_THINKING_BUDGET=

POST_EXAM_ANALYSIS_PROVIDER=
POST_EXAM_ANALYSIS_GEMINI_MODEL=gemini-2.5-flash
POST_EXAM_ANALYSIS_OPENAI_MODEL=
POST_EXAM_ANALYSIS_OPENAI_REASONING_EFFORT=
POST_EXAM_ANALYSIS_GEMINI_THINKING_LEVEL=
POST_EXAM_ANALYSIS_GEMINI_THINKING_BUDGET=

OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/azimeGCP.json
